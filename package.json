{
  "name": "guany.me",
  "private": true,
  "description": "▲ Guany’s website",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "pnpm build",
    "build": "node scripts/generate-content-timestamps.mjs && vite build",
    "preview": "wrangler dev --persist-to .wrangler/state",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "paraglide-js compile && tsc --noEmit",
    "test:routes": "node --test tests/worker-routes.test.mjs",
    "lint": "oxlint src tests",
    "format": "oxfmt .",
    "test:markdown": "node --test tests/remote-markdown.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "simple-icons": "^16.37.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@inlang/paraglide-js": "3.2.2",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "^1.93.0",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@12.16.1"
}
